int length(char str[])
{
    int len = 0;

    while (str[len] != '\n')
    {
        len++;
    }

    return len;
}

void strcopy(char str1[], char str2[])
{
    int i;
    int len = length(str1);

    for (i = 0; i < len; i++)
    {
        str2[i] = str1[i];
    }
    str2[len] = '\0';

    printf("Copied String: %s\n", str2);
}

void concat(char str1[])
{
    int i;
    char str2[100];

    printf("Enter the Second String to Concatinate: ");
    fgets(str2, sizeof(str2), stdin);

    int len1 = length(str1);
    int len2 = length(str2);

    for (i = 0; i < len2; i++)
    {
        str1[len1 + i] = str2[i];
    }
    str1[len1 + len2] = '\0';

    printf("Concatinated String: %s", str1);
}

