int ptr_length(char *str) {
    int len = 0;
    while (*str != '\n') {
        str++;
        len++;
    }
    return len;
}

void ptr_strcopy(char *str1, char *str2) {

    char *p = str2;

    while(*str1 != '\n') {
        *str2 = *str1;
        str1++;
        str2++;
    }
    *str2 = '\0';

    printf("Copied String: %s\n", p);
}

void ptr_concat(char *str1, char *str2) {
    int len1 = ptr_length(str1);
    int len2 = ptr_length(str2);


    for(int i = 0; i < len2; i++) {
        *(str1 + len1 + i) = *(str2 + i); 
    }
    *(str1 + len1 + len2) = '\0';
    
    printf("Concatinated String: %s\n", str1);
}

void ptr_compare(char *str) {
    char str2[100];
    char *p = str2;
    int flag = 1;

    printf("Enter a String to Compare: ");
    fgets(str2, sizeof(str2), stdin);

    while(*str != '\0') {
        if(*str != *p) {
            flag = 0;
            break;
        }
        str++;
        p++;
    }
    if (flag) {
        printf("Equal Strings\n");
    }
    else {
        printf("Not Equal Strings\n");
    }
}

void ptr_palindrome(char *str) {
    char *start = str;
    char *end = str + ptr_length(str) - 1;
    int flag = 1;

    while (start <= end) {
        if(*start != *end) {
            flag = 0;
            break;
        }
        start++;
        end--;
    }
    if(flag) {
        printf("Given String is a Palindrome\n");
    }
    else {
        printf("Given String is Not a Palindrome\n");
    }
}

void ptr_reverse(char *str) {
    char *end = str + ptr_length(str) - 1;

    printf("String in Reverse: ");
    while (end >= str) {
        printf("%c", *end);
        end--;
    }
    printf("\n");
}
